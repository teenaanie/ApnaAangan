# Supabase — easiest source is the "Connect" button at the top of the dashboard.
#
# Project URL is always https://<project-ref>.supabase.co, and the project ref is
# in your browser's address bar: supabase.com/dashboard/project/<project-ref>
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#
# The key: Settings > API Keys. Either kind works here —
#   publishable  sb_publishable_...   (new, shown by default)
#   anon         eyJhbGciOi...        (legacy, under the "Legacy API Keys" tab)
# Never use the secret / service_role key in this file.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Where the app is reachable. Used for auth redirects, the share link, the QR
# code and links inside notification emails.
#
# NO TRAILING SLASH. A slash here produced https://example.com//p/AGN-1061 in
# every share link and QR code once. The app now strips it defensively, but the
# value should still be clean.
#   local       http://localhost:3000
#   production  https://apnaaangan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notification email. WITHOUT RESEND_API_KEY, a provider is never told that an
# enquiry arrived — it is written to the server log instead, and nothing errors.
# The admin dashboard shows a warning while this is unset.
#
# The key is from resend.com > API Keys, and starts re_.
# The from-address domain must be verified at resend.com > Domains first, or
# Resend will only deliver to your own account email.
RESEND_API_KEY=
RESEND_FROM="Apna Aangan <no-reply@apnaaangan.com>"

# Optional. Where a reply to a notification lands. Providers do hit reply, and
# without this the message goes nowhere. A real mailbox, e.g. your own.
RESEND_REPLY_TO=

# ---------------------------------------------------------------------------
# Listing suggestions (optional).
#
# Set ONE key. The provider is inferred from whichever is present, so switching
# services is one variable in Vercel and no code change. With no key at all the
# feature is simply absent — no button, no error.
#
# SERVER ONLY. None of these may ever gain a NEXT_PUBLIC_ prefix: that would
# ship the key to every browser that loads the site.
#
# Cost per suggestion is roughly 600 tokens in, 150 out. At September 2026
# list prices that is about:
#   OpenAI     gpt-5.6-luna          ~₹0.013   ($0.10 / $0.60 per Mtok)
#   Gemini     gemini-2.5-flash-lite ~₹0.008   ($0.075 / $0.30 per Mtok)
#   Anthropic  claude-haiku-4-5      ~₹0.12    ($1 / $5 per Mtok)
#
# A POSTER costs more, because the picture is sent at high detail so the small
# type along the bottom is legible — the timings and the venue are the part
# worth having. Reckon on five to ten times the figures above, so still well
# under a rupee, and it replaces somebody retyping a whole poster.
#
# The model must accept image input. All three defaults below do.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Forces the choice when more than one key is set.
# One of: openai | gemini | anthropic
AANGAN_AI_PROVIDER=

# Optional. Overrides the default model for whichever provider is in use.
# Defaults: gpt-5.6-luna / gemini-2.5-flash-lite / claude-haiku-4-5-20251001
AANGAN_AI_MODEL=
