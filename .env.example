# Supabase — easiest source is the "Connect" button at the top of the dashboard.
#
# Project URL is always https://<project-ref>.supabase.co, and the project ref is
# in your browser's address bar: supabase.com/dashboard/project/<project-ref>
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
#
# The key: Settings > API Keys. Either kind works here —
#   publishable  sb_publishable_...   (new, shown by default)
#   anon         eyJhbGciOi...        (legacy, under the "Legacy API Keys" tab)
# Never use the secret / service_role key in this file.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Where the app is reachable. Used for auth redirects, the share link, the QR
# code and links inside notification emails.
#
# NO TRAILING SLASH. A slash here produced https://example.com//p/AGN-1061 in
# every share link and QR code once. The app now strips it defensively, but the
# value should still be clean.
#   local       http://localhost:3000
#   production  https://apnaaangan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notification email. WITHOUT RESEND_API_KEY, a provider is never told that an
# enquiry arrived — it is written to the server log instead, and nothing errors.
# The admin dashboard shows a warning while this is unset.
#
# The key is from resend.com > API Keys, and starts re_.
# The from-address domain must be verified at resend.com > Domains first, or
# Resend will only deliver to your own account email.
RESEND_API_KEY=
RESEND_FROM="Apna Aangan <no-reply@apnaaangan.com>"

# Optional. Where a reply to a notification lands. Providers do hit reply, and
# without this the message goes nowhere. A real mailbox, e.g. your own.
RESEND_REPLY_TO=
